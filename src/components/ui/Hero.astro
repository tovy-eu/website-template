---
interface Props {
  title: string;
  subtitle?: string;
  primaryCTA?: { label: string; href: string };
  secondaryCTA?: { label: string; href: string };
}

const { title, subtitle, primaryCTA, secondaryCTA } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-20 text-center">
  <h1 class="text-4xl font-bold sm:text-5xl lg:text-6xl">{title}</h1>
  {subtitle && <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">{subtitle}</p>}
  {(primaryCTA || secondaryCTA) && (
    <div class="mt-8 flex justify-center gap-4">
      {primaryCTA && <a href={primaryCTA.href} class="border border-gray-900 bg-gray-900 px-6 py-3 text-sm font-semibold text-white">{primaryCTA.label}</a>}
      {secondaryCTA && <a href={secondaryCTA.href} class="border border-gray-300 px-6 py-3 text-sm font-semibold">{secondaryCTA.label}</a>}
    </div>
  )}
</section>
