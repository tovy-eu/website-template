---
interface Props {
  title: string;
  description?: string;
  action?: { label: string; href: string };
}

const { title, description, action } = Astro.props;
---

<section class="border-y border-gray-200 bg-gray-50 px-4 py-16 text-center">
  <div class="mx-auto max-w-2xl">
    <h2 class="text-3xl font-bold">{title}</h2>
    {description && <p class="mt-2 text-gray-600">{description}</p>}
    {action && (
      <a href={action.href} class="mt-6 inline-block border border-gray-900 bg-gray-900 px-6 py-3 text-sm font-semibold text-white">
        {action.label}
      </a>
    )}
  </div>
</section>
