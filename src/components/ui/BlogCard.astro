---
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  baseUrl?: string;
}

const { title, description, date, slug, baseUrl = '/blog' } = Astro.props;
---

<article class="border border-gray-200 p-6">
  <time class="text-sm text-gray-600" datetime={date.toISOString()}>
    {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
  </time>
  <h3 class="mt-2 text-lg font-semibold">
    <a href={`${baseUrl}/${slug}`}>{title}</a>
  </h3>
  <p class="mt-1 text-sm text-gray-600">{description}</p>
</article>
