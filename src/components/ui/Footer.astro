---
import { t } from '../../lib/i18n';

const content = t(Astro.currentLocale);
const { columns } = content.footer;
---

<footer class="border-t border-gray-200">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Brand -->
    <div>
      <p class="text-lg font-bold">{content.site.name}</p>
      <p class="mt-2 text-sm text-gray-600">{content.site.tagline}</p>
    </div>

    <!-- Link columns -->
    {columns.map(({ title, links }) => (
      <div>
        <p class="font-semibold">{title}</p>
        <ul class="mt-2 space-y-1">
          {links.map(({ label, href }) => (
            <li>
              <a href={href} class="text-sm text-gray-600">{label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="border-t border-gray-200 px-4 py-4 text-center text-sm text-gray-600">
    &copy; {new Date().getFullYear()} {content.site.copyright}
  </div>
</footer>
