---
interface Step {
  title: string;
  description: string;
}

interface Props {
  title?: string;
  steps: Step[];
}

const { title, steps } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-16">
  {title && <h2 class="mb-12 text-center text-3xl font-bold">{title}</h2>}
  <ol class="space-y-8">
    {steps.map(({ title, description }, i) => (
      <li class="flex gap-4">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center border border-gray-300 text-sm font-bold">
          {i + 1}
        </span>
        <div>
          <h3 class="font-semibold">{title}</h3>
          <p class="mt-1 text-sm text-gray-600">{description}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
