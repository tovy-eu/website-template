---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  faqs: FAQ[];
}

const { title, faqs } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-16">
  {title && <h2 class="mb-12 text-center text-3xl font-bold">{title}</h2>}
  <dl class="divide-y divide-gray-200">
    {faqs.map(({ question, answer }) => (
      <details class="group py-4">
        <summary class="flex cursor-pointer items-center justify-between font-semibold">
          <dt>{question}</dt>
          <span class="ml-4 text-gray-400 group-open:rotate-45">+</span>
        </summary>
        <dd class="mt-2 text-sm text-gray-600">{answer}</dd>
      </details>
    ))}
  </dl>

  {/* ponytail: add FAQPage JSON-LD when SEO audit requests it */}
</section>
