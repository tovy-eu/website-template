---
interface PricingTier {
  name: string;
  price: string;
  description: string;
  features: string[];
  cta: { label: string; href: string };
  highlighted?: boolean;
}

interface Props {
  title?: string;
  subtitle?: string;
  tiers: PricingTier[];
}

const { title, subtitle, tiers } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-16">
  {title && (
    <div class="mb-12 text-center">
      <h2 class="text-3xl font-bold">{title}</h2>
      {subtitle && <p class="mt-2 text-gray-600">{subtitle}</p>}
    </div>
  )}
  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {tiers.map(({ name, price, description, features, cta, highlighted }) => (
      <div class:list={["border p-6 flex flex-col", highlighted ? "border-gray-900" : "border-gray-200"]}>
        {highlighted && <span class="mb-2 text-xs font-semibold uppercase">Most popular</span>}
        <h3 class="text-lg font-bold">{name}</h3>
        <p class="mt-1 text-3xl font-bold">{price}</p>
        <p class="mt-2 text-sm text-gray-600">{description}</p>
        <ul class="mt-6 flex-1 space-y-2">
          {features.map((feature) => (
            <li class="flex gap-2 text-sm">
              <span class="text-gray-400">—</span>
              {feature}
            </li>
          ))}
        </ul>
        <a
          href={cta.href}
          class:list={[
            "mt-6 block border px-6 py-3 text-center text-sm font-semibold",
            highlighted ? "border-gray-900 bg-gray-900 text-white" : "border-gray-300",
          ]}
        >
          {cta.label}
        </a>
      </div>
    ))}
  </div>
</section>
