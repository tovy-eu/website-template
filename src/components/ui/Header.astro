---
import MobileNav from '../islands/MobileNav';
import { t } from '../../lib/i18n';

const locale = Astro.currentLocale;
const content = t(locale);
const { links } = content.nav;
const altLocale = locale === 'nl' ? 'en' : 'nl';
const altHref = locale === 'nl' ? '/' : '/nl';
const altLabel = locale === 'nl' ? 'EN' : 'NL';
---

<header class="relative border-b border-gray-200">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a href={links[0].href} class="text-xl font-bold">{content.site.name}</a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-6 md:flex">
      {links.map(({ label, href }) => (
        <li>
          <a href={href} class="text-sm">{label}</a>
        </li>
      ))}
      <li>
        <a href={altHref} class="border border-gray-300 px-2 py-1 text-xs font-semibold">{altLabel}</a>
      </li>
    </ul>

    <!-- Mobile nav -->
    <MobileNav client:visible navLinks={links} altLocale={{ label: altLabel, href: altHref }} />
  </nav>
</header>
