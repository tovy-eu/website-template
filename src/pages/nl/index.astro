---
// ponytail: locale mirror of ../index.astro — Astro.currentLocale = 'nl'
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/ui/Hero.astro';
import Features from '../../components/ui/Features.astro';
import Stats from '../../components/ui/Stats.astro';
import Testimonials from '../../components/ui/Testimonials.astro';
import CTA from '../../components/ui/CTA.astro';
import { t } from '../../lib/i18n';

const content = t(Astro.currentLocale);
const { seo, hero, features, stats, testimonials, cta } = content.home;
---

<BaseLayout title={seo.title} description={seo.description}>
  <Hero title={hero.title} subtitle={hero.subtitle} primaryCTA={hero.primaryCTA} secondaryCTA={hero.secondaryCTA} />
  <Features title={features.title} subtitle={features.subtitle} features={features.items} />
  <Stats stats={stats} />
  <Testimonials title={testimonials.title} testimonials={testimonials.items} />
  <CTA title={cta.title} description={cta.description} action={cta.action} />
</BaseLayout>
