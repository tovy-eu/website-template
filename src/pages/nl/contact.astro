---
// ponytail: locale mirror of ../contact.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/islands/ContactForm';
import { t } from '../../lib/i18n';

const content = t(Astro.currentLocale);
const { seo, heading, description, info, form } = content.contact;
---

<BaseLayout title={seo.title} description={seo.description}>
  <section class="mx-auto max-w-6xl px-4 py-20">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h1 class="text-4xl font-bold">{heading}</h1>
        <p class="mt-4 text-gray-600">{description}</p>
        <dl class="mt-8 space-y-4">
          <div>
            <dt class="font-semibold">E-mail</dt>
            <dd class="text-sm text-gray-600">{info.email}</dd>
          </div>
          <div>
            <dt class="font-semibold">Telefoon</dt>
            <dd class="text-sm text-gray-600">{info.phone}</dd>
          </div>
          <div>
            <dt class="font-semibold">Adres</dt>
            <dd class="text-sm text-gray-600">{info.address}</dd>
          </div>
        </dl>
      </div>
      <div>
        <ContactForm client:visible labels={form} />
      </div>
    </div>
  </section>
</BaseLayout>
