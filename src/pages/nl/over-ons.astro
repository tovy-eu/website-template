---
// ponytail: locale mirror of ../about.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/ui/Hero.astro';
import Steps from '../../components/ui/Steps.astro';
import Stats from '../../components/ui/Stats.astro';
import CTA from '../../components/ui/CTA.astro';
import { t } from '../../lib/i18n';

const content = t(Astro.currentLocale);
const { seo, hero, story, stats, values, cta } = content.about;
---

<BaseLayout title={seo.title} description={seo.description}>
  <Hero title={hero.title} subtitle={hero.subtitle} />
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h2 class="text-3xl font-bold">{story.title}</h2>
    {story.paragraphs.map((p) => <p class="mt-4 text-gray-600">{p}</p>)}
  </section>
  <Stats stats={stats} />
  <Steps title={values.title} steps={values.items} />
  <CTA title={cta.title} description={cta.description} action={cta.action} />
</BaseLayout>
