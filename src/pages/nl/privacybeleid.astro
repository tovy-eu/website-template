---
// ponytail: locale mirror of ../privacy.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../lib/i18n';

const content = t(Astro.currentLocale);
const { seo, heading, sections } = content.privacy;
---

<BaseLayout title={seo.title} description={seo.description}>
  <article class="prose mx-auto max-w-3xl px-4 py-20">
    <h1>{heading}</h1>
    <p><em>Laatst bijgewerkt: {new Date().toLocaleDateString('nl-NL', { year: 'numeric', month: 'long', day: 'numeric' })}</em></p>
    {sections.map(({ title, content: text }) => (
      <>
        <h2>{title}</h2>
        <p>{text}</p>
      </>
    ))}
  </article>
</BaseLayout>
