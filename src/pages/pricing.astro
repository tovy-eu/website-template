---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import PricingCards from '../components/ui/PricingCards.astro';
import FAQs from '../components/ui/FAQs.astro';
import CTA from '../components/ui/CTA.astro';
import { t } from '../lib/i18n';

const content = t(Astro.currentLocale);
const { seo, hero, tiers, faqs, cta } = content.pricing;
---

<BaseLayout title={seo.title} description={seo.description}>
  <Hero title={hero.title} subtitle={hero.subtitle} />
  <PricingCards title={tiers.title} subtitle={tiers.subtitle} tiers={tiers.items} />
  <FAQs title={faqs.title} faqs={faqs.items} />
  <CTA title={cta.title} description={cta.description} action={cta.action} />
</BaseLayout>
