---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../lib/i18n';

const content = t(Astro.currentLocale);
const { seo, heading, title, description, button } = content.notFound;
---

<BaseLayout title={seo.title} description={seo.description} noindex>
  <section class="mx-auto max-w-3xl px-4 py-20 text-center">
    <p class="text-6xl font-bold">{heading}</p>
    <h1 class="mt-4 text-2xl font-semibold">{title}</h1>
    <p class="mt-2 text-gray-600">{description}</p>
    <a href={button.href} class="mt-6 inline-block border border-gray-900 bg-gray-900 px-6 py-3 text-sm font-semibold text-white">
      {button.label}
    </a>
  </section>
</BaseLayout>
